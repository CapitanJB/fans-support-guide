---
/**
 * Weather Widget Component
 * Displays specific weather forecast for the selected match
 */
import { useTranslations } from '../i18n/utils';
const t = useTranslations();
---

<section class="weather-widget">
  <h3>⛅ {t('weather.title')}</h3>
  <div id="weather-match-container">
    <div class="weather-skeleton">{t('weather.select_match')}</div>
  </div>
</section>

<style is:global>
  .weather-widget {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 1.2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px var(--card-shadow);
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  .weather-widget h3 {
    margin-top: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .weather-card-large {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap; /* Permitir envolver en móviles */
  }

  .weather-info {
    flex: 1;
    min-width: 0; /* Permitir encoger totalmente */
  }

  @media (max-width: 480px) {
    .temp-large {
      font-size: 2rem;
    }
    .weather-icon-large {
      font-size: 2.5rem;
    }
    .weather-main {
      gap: 0.5rem;
    }
  }

  .match-venue {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
  }

  .match-teams {
    font-weight: bold;
    font-size: 1.1rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .venue-separator {
    border: 0;
    height: 1px;
    background: var(--border);
    margin: 0.4rem 0;
    width: 40px;
  }

  .match-date {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
  }

  .weather-main {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .temp-large {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .condition-badge {
    background: var(--bg-primary);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    border: 1px solid var(--border);
  }

  .weather-icon-large {
    font-size: 3rem;
  }

  .stale-info {
    font-size: 0.7rem;
    color: var(--accent);
    margin-top: 0.5rem;
    font-style: italic;
  }

  .no-forecast-inline {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: var(--bg-primary);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    display: inline-block;
    border: 1px dashed var(--border);
    margin-top: 0.2rem;
  }

  .weather-skeleton {
    text-align: center;
    padding: 1.5rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .weather-footer {
    margin-top: 1rem;
    text-align: right;
    border-top: 1px solid var(--border);
    padding-top: 0.8rem;
  }

  .weather-detail-link {
    font-size: 0.85rem;
  }
</style>

<script is:inline define:vars={{ 
  consultingText: t('weather.consulting'),
  noForecastText: t('weather.no_forecast'),
  staleText: t('weather.stale'),
  staleAtText: t('weather.stale_at'),
  errorText: t('weather.error'),
  viewDetailText: t('weather.view_detail'),
  venueLabel: t('map.venue_label'),
  // Weather conditions dictionary
  conditions: {
    'weather.condition.0': t('weather.condition.0'),
    'weather.condition.1': t('weather.condition.1'),
    'weather.condition.2': t('weather.condition.2'),
    'weather.condition.3': t('weather.condition.3'),
    'weather.condition.45': t('weather.condition.45'),
    'weather.condition.48': t('weather.condition.48'),
    'weather.condition.51': t('weather.condition.51'),
    'weather.condition.53': t('weather.condition.53'),
    'weather.condition.55': t('weather.condition.55'),
    'weather.condition.61': t('weather.condition.61'),
    'weather.condition.63': t('weather.condition.63'),
    'weather.condition.65': t('weather.condition.65'),
    'weather.condition.71': t('weather.condition.71'),
    'weather.condition.73': t('weather.condition.73'),
    'weather.condition.75': t('weather.condition.75'),
    'weather.condition.80': t('weather.condition.80'),
    'weather.condition.81': t('weather.condition.81'),
    'weather.condition.82': t('weather.condition.82'),
    'weather.condition.95': t('weather.condition.95'),
    'weather.condition.96': t('weather.condition.96'),
    'weather.condition.99': t('weather.condition.99'),
    'weather.condition.unknown': t('weather.condition.unknown')
  }
}}>
  import { getMatchWeather, getWeatherInfo } from '../services/weather-service';

  let currentMatch = null;

  async function updateMatchWeather(match) {
    const container = document.getElementById('weather-match-container');
    if (!container) return;

    currentMatch = match;
    container.innerHTML = `<div class="weather-skeleton">${consultingText}</div>`;

    try {
      const data = await getMatchWeather(match);
      
      if (!data) {
        container.innerHTML = `
        <div class="weather-card-large">
          <div class="weather-info">
            <span class="match-venue">📍 ${match.stadium?.name || venueLabel}</span>
            <hr class="venue-separator" />
            <span class="match-teams"><strong>${match.homeTeam} vs ${match.awayTeam}</strong></span><br />
            <span class="match-date">📅 ${match.date}</span>
            <div class="no-forecast-inline">
              ${noForecastText}
            </div>
          </div>
        </div>
        `;
        return;
      }

      const { key, emoji } = getWeatherInfo(data.condition);
      const text = conditions[key] || conditions['weather.condition.unknown'];
      const staleLabel = data.isStale 
        ? `<div class="stale-info">${staleText} ${staleAtText.replace('{time}', data.staleTime)}</div>` 
        : '';

      container.innerHTML = `
        <div class="weather-card-large">
          <div class="weather-info">
            <span class="match-venue">📍 ${match.stadium?.name || venueLabel}</span>
            <hr class="venue-separator" />
            <span class="match-teams"><strong>${match.homeTeam} vs ${match.awayTeam}</strong></span><br />
            <span class="match-date">📅 ${match.date}</span>
            <div class="weather-main">
              <span class="temp-large">${data.temp}°C</span>
              <span class="condition-badge">${text}</span>
            </div>
            ${staleLabel}
          </div>
          <div class="weather-icon-large">${emoji}</div>
        </div>
        <div class="weather-footer">
          <a href="https://www.google.com/search?q=weather+${encodeURIComponent(match.city||match.stadium?.name||'')}+${match.date}" target="_blank" rel="noopener noreferrer" class="weather-detail-link">${viewDetailText}</a>
        </div>
      `;
    } catch (error) {
      container.innerHTML = `<div class="weather-skeleton">${errorText}</div>`;
    }
  }

  // Listen for match selection events
  window.addEventListener('match:selected', (e) => {
    updateMatchWeather(e.detail.match);
  });

  // Re-fetch when coming back online if we have a match
  window.addEventListener('online', () => {
    if (currentMatch) updateMatchWeather(currentMatch);
  });
</script>
