---
/**
 * Weather Widget Component
 * Displays specific weather forecast for the selected match
 */
---

<section class="weather-widget">
  <h3>⛅ Pronóstico del tiempo para el partido</h3>
  <div id="weather-match-container">
    <div class="weather-skeleton">Selecciona un partido para ver el clima...</div>
  </div>
</section>

<style is:global>
  .weather-widget {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 1.2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px var(--card-shadow);
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  .weather-widget h3 {
    margin-top: 0;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .weather-card-large {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap; /* Permitir envolver en móviles */
  }

  .weather-info {
    flex: 1;
    min-width: 0; /* Permitir encoger totalmente */
  }

  @media (max-width: 480px) {
    .temp-large {
      font-size: 2rem;
    }
    .weather-icon-large {
      font-size: 2.5rem;
    }
    .weather-main {
      gap: 0.5rem;
    }
  }

  .match-venue {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 0.2rem;
  }

  .match-teams {
    font-weight: bold;
    font-size: 1.1rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .venue-separator {
    border: 0;
    height: 1px;
    background: var(--border);
    margin: 0.4rem 0;
    width: 40px;
  }

  .match-date {
    display: block;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.8rem;
  }

  .weather-main {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .temp-large {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .condition-badge {
    background: var(--bg-primary);
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-size: 0.8rem;
    border: 1px solid var(--border);
  }

  .weather-icon-large {
    font-size: 3rem;
  }

  .stale-info {
    font-size: 0.7rem;
    color: var(--accent);
    margin-top: 0.5rem;
    font-style: italic;
  }

  .no-forecast-inline {
    font-size: 0.8rem;
    color: var(--text-secondary);
    background: var(--bg-primary);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    display: inline-block;
    border: 1px dashed var(--border);
    margin-top: 0.2rem;
  }

  .weather-skeleton {
    text-align: center;
    padding: 1.5rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .weather-footer {
    margin-top: 1rem;
    text-align: right;
    border-top: 1px solid var(--border);
    padding-top: 0.8rem;
  }

  .weather-detail-link {
    font-size: 0.85rem;
  }
</style>

<script>
  import { getMatchWeather, getWeatherDescription } from '../services/weather-service';
  import type { Match } from '../services/match-service';

  let currentMatch: Match | null = null;

  async function updateMatchWeather(match: Match) {
    const container = document.getElementById('weather-match-container');
    if (!container) return;

    currentMatch = match;
    container.innerHTML = '<div class="weather-skeleton">Consultando satélites...</div>';

    try {
      const data = await getMatchWeather(match);
      
      if (!data) {
        container.innerHTML = `
        <div class="weather-card-large">
          <div class="weather-info">
            <span class="match-venue">📍 ${match.stadium?.nombre || 'Estadio'}</span>
            <hr class="venue-separator" />
            <span class="match-teams"><strong>${match.homeTeam} vs ${match.awayTeam}</strong></span><br />
            <span class="match-date">📅 ${match.date}</span>
            <div class="no-forecast-inline">
              ⏳ El pronóstico estará disponible 14 días antes.
            </div>
          </div>
        </div>
        `;
        return;
      }

      const { text, emoji } = getWeatherDescription(data.condition);
      const staleLabel = data.isStale 
        ? `<div class="stale-info">⚠️ Datos sin conexión (Act. ${data.staleTime})</div>` 
        : '';

      container.innerHTML = `
        <div class="weather-card-large">
          <div class="weather-info">
            <span class="match-venue">📍 ${match.stadium?.nombre || 'Estadio'}</span>
            <hr class="venue-separator" />
            <span class="match-teams"><strong>${match.homeTeam} vs ${match.awayTeam}</strong></span><br />
            <span class="match-date">📅 ${match.date}</span>
            <div class="weather-main">
              <span class="temp-large">${data.temp}°C</span>
              <span class="condition-badge">${text}</span>
            </div>
            ${staleLabel}
          </div>
          <div class="weather-icon-large">${emoji}</div>
        </div>
        <div class="weather-footer">
          <a href="https://www.google.com/search?q=clima+${encodeURIComponent(match.ciudad||match.stadium?.nombre||'')}+${match.date}" target="_blank" rel="noopener noreferrer" class="weather-detail-link">Ver predicción detallada ↗</a>
        </div>
      `;
    } catch (error) {
      container.innerHTML = '<div class="weather-skeleton">Error al cargar datos de clima.</div>';
    }
  }

  // Listen for match selection events
  window.addEventListener('match:selected', (e: any) => {
    updateMatchWeather(e.detail.match);
  });

  // Re-fetch when coming back online if we have a match
  window.addEventListener('online', () => {
    if (currentMatch) updateMatchWeather(currentMatch);
  });
</script>
