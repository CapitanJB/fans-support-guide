---
// Map.astro - Component for Leaflet.js
import { useTranslations } from '../i18n/utils';
const t = useTranslations();
---

<div class="map-controls">
  <div class="filter-bar" id="filter-bar">
    <button class="filter-btn active" data-category="Todos">{t('categories.all')}</button>
    <button class="filter-btn" data-category="Estadio">{t('categories.stadium')}</button>
    <button class="filter-btn" data-category="Transporte">{t('categories.transport')}</button>
    <button class="filter-btn" data-category="Parking">{t('categories.parking')}</button>
    <button class="filter-btn" data-category="FanZone">{t('categories.fanzone')}</button>
    <button class="filter-btn" data-category="Seguridad">{t('categories.security')}</button>
    <button class="filter-btn" data-category="Salud">{t('categories.health')}</button>
  </div>
</div>

<div id="map"></div>

<style>
  .map-controls {
    margin-bottom: 10px;
  }
  .filter-bar {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: none; /* Firefox */
  }
  .filter-bar::-webkit-scrollbar { display: none; } /* Chrome/Safari */

  .filter-btn {
    white-space: nowrap;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
  }
  .filter-btn.active {
    background: var(--text-primary);
    color: var(--bg-primary);
    border-color: var(--text-primary);
  }
  #map {
    height: 60vh;
    width: 100%;
    background-color: var(--bg-secondary);
    border-radius: 8px;
    box-shadow: 0 4px 6px -1px var(--card-shadow);
    transition: filter 0.3s;
  }

  /* Dark mode map filter */
  [data-theme='dark'] #map {
    filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%);
  }
  [data-theme='power-save'] #map {
    filter: invert(100%) hue-rotate(180deg) brightness(80%) contrast(100%) grayscale(100%);
  }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<script is:inline define:vars={{
  venueLabel: t('map.venue_label'),
  categoryTranslations: {
    'Estadio': t('categories.stadium'),
    'Salud': t('categories.health'),
    'Seguridad': t('categories.security'),
    'Transporte': t('categories.transport'),
    'FanZone': t('categories.fanzone'),
    'Parking': t('categories.parking'),
    'Todos': t('categories.all')
  }
}}>
  import L from 'leaflet';
  import { fetchPOIs } from '../services/data-fetch';

  const categoryColors = {
    'Estadio': '#1a237e',
    'Salud': '#d32f2f',
    'Seguridad': '#fbc02d',
    'Transporte': '#2e7d32',
    'FanZone': '#7b1fa2',
    'Parking': '#01579b',
  };

  const getIcon = (category) => {
    const color = categoryColors[category] || '#555';
    return L.divIcon({
      html: `<svg width="32" height="32" viewBox="0 0 24 24" fill="${color}" xmlns="http://www.w3.org/2000/svg"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-12-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>`,
      className: 'custom-marker',
      iconSize: [32, 32],
      iconAnchor: [16, 32],
      popupAnchor: [0, -32]
    });
  };

  let map;
  let markerGroup;
  let allPois = [];
  let currentCity = '';
  let currentCategory = 'Todos';

  const initMap = async () => {
    const defaultCenter = [19.3029, -99.1505];
    
    if (map) return;

    map = L.map('map').setView(defaultCenter, 13);
    markerGroup = L.featureGroup().addTo(map);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    allPois = await fetchPOIs();
    updateMarkers();

    // Setup filter listeners
    const buttons = document.querySelectorAll('.filter-btn');
    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        currentCategory = target.dataset.category || 'Todos';
        
        buttons.forEach(b => b.classList.remove('active'));
        target.classList.add('active');
        
        updateMarkers();
      });
    });
  };

  const updateMarkers = () => {
    if (!markerGroup) return;
    markerGroup.clearLayers();

    let filtered = allPois;

    // Filter by City if context exists, but KEEP 'Seguridad' category globally
    if (currentCity) {
      filtered = filtered.filter(p => p.city === currentCity || p.category === 'Seguridad');
    }

    // Filter by Category
    if (currentCategory !== 'Todos') {
      filtered = filtered.filter(p => p.category === currentCategory);
    }

    if (filtered.length > 0) {
      filtered.forEach(poi => {
        const translatedCat = categoryTranslations[poi.category] || poi.category;
        const marker = L.marker([poi.latitude, poi.longitude], { icon: getIcon(poi.category) })
          .bindPopup(`
            <div style="font-family: sans-serif;">
              <h3 style="margin: 0 0 5px 0;">${poi.name}</h3>
              <p style="margin: 0 0 5px 0;"><b>${translatedCat}</b></p>
              <p style="margin: 0;">${poi.description}</p>
              <small>${poi.address}</small>
            </div>
          `);
        markerGroup.addLayer(marker);
      });

      if (currentCategory === 'Seguridad' || !currentCity) {
        map.fitBounds(markerGroup.getBounds(), { padding: [50, 50] });
      }
    }
  };

  // Listen for match selection
  window.addEventListener('match:selected', (e) => {
    const match = e.detail.match;
    if (!match) return;

    currentCity = match.city;
    updateMarkers();

    if (match.stadium && map) {
      map.flyTo([match.stadium.latitude, match.stadium.longitude], 15, {
        duration: 1.5
      });
      
      setTimeout(() => {
        L.popup()
          .setLatLng([match.stadium.latitude, match.stadium.longitude])
          .setContent(`<b>${venueLabel} ${match.stadium.name}</b><br>${match.homeTeam} vs ${match.awayTeam}`)
          .openOn(map);
      }, 1600);
    }
  });

  window.addEventListener('map:center', (e) => {
    if (!map) return;
    const { lat, lon, name } = e.detail;
    map.setView([lat, lon], 16);
    L.popup().setLatLng([lat, lon]).setContent(`<b>${name}</b>`).openOn(map);
  });

  document.addEventListener('astro:page-load', initMap);
  if (document.readyState === 'complete') initMap();
  else window.addEventListener('load', initMap);
</script>
