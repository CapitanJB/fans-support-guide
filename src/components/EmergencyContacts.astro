---
// EmergencyContacts.astro
import { useTranslations } from '../i18n/utils';
const t = useTranslations();

const contacts = [
  {
    country: "México",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 20" width="24" height="15"><rect width="10.6" height="20" fill="#006847"/><rect x="10.6" width="10.8" height="20" fill="#fff"/><rect x="21.4" width="10.6" height="20" fill="#CE1126"/><circle cx="16" cy="10" r="1.5" fill="#8B4513"/></svg>`,
    numbers: [
      { label: t('emergency.label.general'), value: "911" },
      { label: t('emergency.label.consular_guadalajara'), value: "+52 33 3116 4272" },
      { label: t('emergency.label.red_cross'), value: "065" }
    ]
  },
  {
    country: "USA",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 20" width="24" height="15"><rect width="32" height="20" fill="#B22234"/><path d="M0 1.54h32v1.54H0zm0 3.08h32v1.54H0zm0 3.08h32v1.54H0zm0 3.08h32v1.54H0zm0 3.08h32v1.54H0zm0 3.08h32v1.54H0z" fill="#fff"/><rect width="12.8" height="10.77" fill="#3C3B6E"/></svg>`,
    numbers: [
      { label: t('emergency.label.general'), value: "911" },
      { label: t('emergency.label.consular_miami'), value: "+1 305 790 1851" },
      { label: t('emergency.label.consular_la'), value: "+1 323 445 0484" },
      { label: t('emergency.label.consular_houston'), value: "+1 713 962 6284" }
    ]
  }
];
---

<div class="emergency-container">
  <h3>{t('emergency.title')}</h3>
  <div class="emergency-grid">
    {contacts.map(c => (
      <div class="country-card">
        <div class="country-header">
          <span class="flag-icon" set:html={c.icon}></span>
          <strong>{c.country}</strong>
        </div>
        <ul>
          {c.numbers.map(n => (
            <li>
              <span>{n.label}:</span>
              <a href={`tel:${n.value.replace(/\s+/g, '')}`} class="call-link">{n.value}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<style>
  .emergency-container {
    background: var(--status-offline);
    padding: 1.5rem;
    border-radius: 12px;
    margin-top: 2rem;
    border: 2px solid var(--status-offline-text);
  }
  h3 { margin-top: 0; color: var(--status-offline-text); display: flex; align-items: center; gap: 10px; }
  .emergency-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); /* Reducido de 200px a 150px */
    gap: 15px;
  }
  .country-card {
    background: var(--bg-secondary);
    color: var(--text-primary);
    padding: 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    min-width: 0; /* Permitir encoger en grid */
  }
  .country-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
    flex-wrap: wrap;
  }
  .flag-icon {
    display: flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 2px;
    overflow: hidden;
  }
  .country-header strong { margin: 0; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { 
    display: flex; 
    justify-content: space-between; 
    align-items: flex-start; 
    font-size: 0.9rem; 
    margin-bottom: 8px; 
    gap: 10px; 
    flex-wrap: wrap; /* Permitir envolver */
  }
  li span { flex: 1; min-width: 80px; }
  .call-link {
    color: var(--accent);
    font-weight: bold;
    text-decoration: none;
    background: var(--bg-primary);
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid var(--border);
    font-size: 0.85rem;
  }
</style>
