---
/**
 * StadiumRules.astro - Pocket guide for stadium security
 */
import { useTranslations } from '../i18n/utils';
const t = useTranslations();

const prohibited = [
  { item: t('rules.item.glass'), icon: "🚫" },
  { item: t('rules.item.bags_large'), icon: "🚫" },
  { item: t('rules.item.cameras'), icon: "📷" },
  { item: t('rules.item.umbrellas'), icon: "☂️" },
  { item: t('rules.item.lasers'), icon: "✨" },
  { item: t('rules.item.batteries_large'), icon: "🔋" }
];

const permitted = [
  { item: t('rules.item.plastic_bottles'), icon: "✅" },
  { item: t('rules.item.bags_small'), icon: "👛" },
  { item: t('rules.item.batteries_small'), icon: "📱" },
  { item: t('rules.item.rain_cape'), icon: "🧥" }
];

const flagRules = [
  { item: t('rules.flag.size'), icon: "🏳️" },
  { item: t('rules.flag.fire'), icon: "🔥" },
  { item: t('rules.flag.poles'), icon: "📏" },
  { item: t('rules.flag.positive'), icon: "🤝" },
  { item: t('rules.flag.commercial'), icon: "🚫" },
  { item: t('rules.flag.offensive'), icon: "🛑" }
];

const bagRules = [
  { item: t('rules.bag.transparent'), icon: "🛍️" },
  { item: t('rules.bag.small'), icon: "👛" },
  { item: t('rules.bag.limit'), icon: "👤" }
];
---

<section class="rules-container">
  <button id="rules-toggle" class="rules-header">
    <h3>{t('rules.title')}</h3>
    <span id="toggle-icon">▼</span>
  </button>
  
  <div id="rules-content" class="rules-content hidden">
    <div class="rules-grid">
      <div class="rules-column prohibited">
        <h4>{t('rules.prohibited')}</h4>
        <ul>
          {prohibited.map(p => (
            <li><span class="icon">{p.icon}</span> {p.item}</li>
          ))}
        </ul>
      </div>
      <div class="rules-column permitted">
        <h4>{t('rules.permitted')}</h4>
        <ul>
          {permitted.map(p => (
            <li><span class="icon">{p.icon}</span> {p.item}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="rules-details">
      <div class="detail-section">
        <h5>{t('rules.flags')}</h5>
        <ul>
          {flagRules.map(r => (
            <li><span class="icon">{r.icon}</span> {r.item}</li>
          ))}
        </ul>
      </div>
      <div class="detail-section">
        <h5>{t('rules.bags')}</h5>
        <ul>
          {bagRules.map(r => (
            <li><span class="icon">{r.icon}</span> {r.item}</li>
          ))}
        </ul>
      </div>
    </div>

    <p class="disclaimer">{t('rules.disclaimer')}</p>
  </div>
</section>

<style>
  .rules-container {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-top: 1.5rem;
    overflow: hidden;
    box-shadow: 0 4px 6px var(--card-shadow);
  }

  .rules-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    background: var(--bg-primary);
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    font-size: inherit;
    text-align: left;
  }

  .rules-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .rules-content {
    padding: 1.5rem;
  }

  .hidden { display: none; }

  .rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .rules-column h4, .detail-section h5 {
    margin-top: 0;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    padding-bottom: 5px;
    border-bottom: 2px solid var(--border);
  }

  .prohibited h4 { color: var(--accent); border-color: var(--accent); }
  .permitted h4 { color: #2e7d32; border-color: #2e7d32; }

  .rules-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
  }

  .detail-section h5 {
    color: var(--text-primary);
    border-bottom-style: dotted;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li {
    font-size: 0.85rem;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-primary);
  }

  .icon { font-size: 1rem; }

  .disclaimer {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-style: italic;
    text-align: center;
  }
</style>

<script>
  const toggleBtn = document.getElementById('rules-toggle');
  const content = document.getElementById('rules-content');
  const icon = document.getElementById('toggle-icon');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = content?.classList.toggle('hidden');
    if (icon) {
      icon.textContent = isHidden ? '▼' : '▲';
    }
  });
</script>
